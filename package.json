{
  "name": "rytm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:dev": "electron . --dev",
    "dist:win": "vite build && electron-builder --win portable",
    "dist:mac": "vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.0"
  },
  "description": "Rytm – asystent zdrowia przy biurku",
  "main": "electron/main.cjs",
  "build": {
    "appId": "pl.hackyeah.rytm",
    "productName": "Rytm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Rytm-${version}.exe"
    },
    "electronDist": "node_modules/electron/dist",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness",
      "artifactName": "Rytm-${version}-${arch}.dmg",
      "extendInfo": {
        "NSCameraUsageDescription": "Rytm analizuje obraz z kamery na tym komputerze, żeby ocenić postawę i oznaki zmęczenia. Obraz nie jest zapisywany ani wysyłany."
      }
    }
  }
}
